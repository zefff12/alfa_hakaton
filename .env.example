# Скопируйте в .env и при необходимости измените. Все значения — для локальной демонстрации.

# PostgreSQL
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit

# Подпись JWT (в продакшене — из хранилища секретов)
JWT_SECRET=change-me-in-production-please-32b

# Кредитный конвейер
PIPELINE_STEP_DELAY_S=2.5        # пауза между автоматическими этапами (наглядность демо)
AUTO_DECISION_LIMIT=10000000     # выше этой суммы решение принимает только андеррайтер

# Симуляторы внешних сервисов
MOCK_FAILURE_RATE=0              # доля случайных сбоев 0..1 (проверка отказоустойчивости)
MOCK_LATENCY_MS=300

# Альфик: локальная LLM с открытыми весами (запуск с профилем llm)
LLM_ENABLED=false
LLM_MODEL=qwen2.5:3b
